[app]

# ============================================================
# APPLICATION
# ============================================================

title = ТехПрофи

package.name = testov

package.domain = ru.testov

version = 0.2.0


# ============================================================
# SOURCE
# ============================================================

source.dir = .

# В APK должны попасть:
# Python, KV, изображения, шрифты,
# JSON и файлы банков вопросов DAT.
source.include_exts = py,kv,png,jpg,jpeg,json,dat,ttf


# ============================================================
# APPLICATION FILES
# ============================================================

# Иконка приложения
icon.filename = %(source.dir)s/assets/icon.png


# ============================================================
# REQUIREMENTS
# ============================================================

# Не фиксируем старую версию python-for-android здесь.
# Python и Kivy будут собираться через актуальную
# совместимую конфигурацию p4a.

requirements = python3,kivy


# ============================================================
# ORIENTATION / WINDOW
# ============================================================

orientation = portrait

fullscreen = 0


# ============================================================
# ANDROID
# ============================================================

# Target Android API
android.api = 35

# Minimum supported Android API
android.minapi = 23

# На этапе восстановления сборки используем
# только современную 64-bit архитектуру.
#
# После получения стабильного APK при необходимости
# можно вернуть armeabi-v7a.
android.archs = arm64-v8a


# ============================================================
# ANDROID PERMISSIONS
# ============================================================

# Для текущей версии приложения специальные
# Android permissions не требуются.
#
# Если позже понадобятся интернет, камера,
# файлы и т.д. — добавим отдельно.


# ============================================================
# ANDROID BACKUP
# ============================================================

android.allow_backup = True


# ============================================================
# LOGGING
# ============================================================

log_level = 2


# ============================================================
# BUILDOZER
# ============================================================

[buildozer]

log_level = 2

warn_on_root = 1
