#:import dp kivy.metrics.dp


# =========================================================
# ОБЩИЕ НАСТРОЙКИ
# =========================================================

<Label>:
    font_name: 'AppArial'
    italic: False

<Button>:
    font_name: 'AppArial'
    italic: False

<ToggleButton>:
    font_name: 'AppArial'
    italic: False


# =========================================================
# СТРОКА ИСТОЧНИКА
# Используется динамическим списком .dat
# =========================================================

<SourceRow@BoxLayout>:

    source_id: ''
    source_name: ''
    selected: False

    orientation: 'horizontal'

    size_hint_y: None
    height: max(dp(72), source_label.texture_size[1] + dp(24))

    spacing: dp(8)
    padding: dp(8), dp(6)

    canvas.before:

        Color:
            rgba: .98, .97, .94, 1

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

    canvas.after:

        Color:
            rgba: .55, .50, .44, 1

        Line:
            rounded_rectangle:
                (self.x, self.y, self.width, self.height, dp(8))
            width: 1

    CheckBox:

        size_hint_x: None
        width: dp(42)

        active: root.selected

        color:
            .20, .16, .12, 1

        on_active:
            app.root.get_screen('settings').set_source_selected(
            root.source_id,
            self.active
            )

    Label:

        id: source_label

        text: root.source_name

        color:
            .08, .07, .06, 1

        font_size: '14sp'

        bold: False

        halign: 'left'
        valign: 'middle'

        text_size:
            self.width, None

        size_hint_y: None

        height:
            self.texture_size[1] + dp(16)


# =========================================================
# SCREEN MANAGER
# =========================================================

ScreenManager:

    Login:

    Test:

    Result:

    AdminSettings:


# =========================================================
# ГЛАВНЫЙ ЭКРАН
# =========================================================

<Login>:

    name: 'login'

    canvas.before:

        Color:
            rgba: .96, .92, .85, 1

        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:

        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:

            orientation: 'vertical'

            size_hint_y: None

            height:
                max(self.minimum_height, root.height)

            padding:
                dp(28), dp(18), dp(28), dp(28)

            spacing: dp(12)


            Widget:

                size_hint_y: None
                height: dp(12)


            # =================================================
            # ЛОГО
            # =================================================

            Image:

                source: 'assets/logo.png'

                size_hint_y: None
                height: dp(125)

                fit_mode: 'contain'


            # =================================================
            # НАЗВАНИЕ
            # =================================================

            Label:

                text: 'ТехПрофи'

                color:
                    .08, .07, .06, 1

                font_size: '32sp'

                bold: True

                size_hint_y: None
                height: dp(48)

                halign: 'center'
                valign: 'middle'

                text_size: self.size


            Label:

                text:
                    'Знания. Безопасность. Профессионализм.'

                color:
                    .22, .19, .16, 1

                font_size: '14sp'

                size_hint_y: None
                height: dp(34)

                halign: 'center'
                valign: 'middle'

                text_size: self.size


            Widget:

                size_hint_y: None
                height: dp(8)


            # =================================================
            # ФАМИЛИЯ И ИНИЦИАЛЫ
            # =================================================

            TextInput:

                id: name

                hint_text:
                    'Фамилия и инициалы'

                font_name:
                    'AppArial'

                font_size:
                    '18sp'

                multiline:
                    False

                size_hint_y:
                    None

                height:
                    dp(58)

                foreground_color:
                    0, 0, 0, 1

                hint_text_color:
                    .45, .45, .45, 1

                background_normal:
                    ''

                background_active:
                    ''

                background_color:
                    1, 1, 1, 1

                padding:
                    [dp(14), (self.height - self.line_height) / 2 - dp(2)]

                on_text:
                    root.update_admin_state()


            Label:

                id: msg

                text: ''

                color:
                    .75, .10, .10, 1

                font_size:
                    '14sp'

                size_hint_y:
                    None

                height:
                    dp(30) if self.text else 0

                text_size:
                    self.width, None

                halign:
                    'center'

                valign:
                    'middle'


            # =================================================
            # КОНТРОЛЬ
            # =================================================

            Button:

                text:
                    'Контрольное тестирование'

                color:
                    .08, .07, .06, 1

                font_size:
                    '17sp'

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    .83, .73, .61, 1

                size_hint_y:
                    None

                height:
                    dp(60)

                on_release:
                    root.start('контроль')


            # =================================================
            # ОБУЧЕНИЕ
            # =================================================

            Button:

                text:
                    'Обучение'

                color:
                    .08, .07, .06, 1

                font_size:
                    '17sp'

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    .83, .73, .61, 1

                size_hint_y:
                    None

                height:
                    dp(60)

                on_release:
                    root.start('обучение')


            # =================================================
            # НАСТРОЙКИ
            # =================================================

            Button:

                text:
                    'Настройки'

                color:
                    (.08, .07, .06, 1) if root.admin_enabled else (.42, .42, .42, 1)

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    (.83, .73, .61, 1) if root.admin_enabled else (.70, .68, .64, 1)

                disabled:
                    not root.admin_enabled

                size_hint_y:
                    None

                height:
                    dp(56)

                on_release:
                    root.open_settings()


            Widget:

                size_hint_y: None
                height: dp(18)


# =========================================================
# ЭКРАН ТЕСТИРОВАНИЯ
# =========================================================

<Test>:

    name: 'test'

    canvas.before:

        Color:
            rgba: .97, .96, .94, 1

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:

        orientation: 'vertical'

        padding:
            dp(14), dp(28), dp(14), dp(24)

        spacing:
            dp(8)


        # =================================================
        # ВЕРХНЯЯ ПАНЕЛЬ
        # =================================================

        BoxLayout:

            size_hint_y: None
            height: dp(54)

            spacing: dp(10)


            Label:

                text:
                    root.progress

                color:
                    .08, .07, .06, 1

                font_size:
                    '18sp'

                halign:
                    'left'

                valign:
                    'middle'

                text_size:
                    self.size


            # =================================================
            # ЦИФРОВОЙ ТАЙМЕР
            # =================================================

            BoxLayout:

                size_hint_x: None

                width:
                    dp(110) if app.mode == 'контроль' else 0

                opacity:
                    1 if app.mode == 'контроль' else 0

                disabled:
                    app.mode != 'контроль'

                padding:
                    dp(4) if app.mode == 'контроль' else 0


                canvas.before:

                    Color:

                        rgba:
                            (.12, .105, .09, 1) if app.mode == 'контроль' else (0, 0, 0, 0)

                    RoundedRectangle:

                        pos:
                            self.pos

                        size:
                            self.size

                        radius:
                            [dp(8)]


                canvas.after:

                    Color:

                        rgba:
                            (.68, .55, .40, 1) if app.mode == 'контроль' else (0, 0, 0, 0)

                    Line:

                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, dp(8))

                        width:
                            1.2 if app.mode == 'контроль' else 0


                Label:

                    text:
                        root.timer if app.mode == 'контроль' else ''

                    color:
                        .98, .86, .62, 1

                    font_size:
                        '22sp'

                    bold:
                        True

                    halign:
                        'center'

                    valign:
                        'middle'

                    text_size:
                        self.size


        # =================================================
        # ВОПРОС / ОТВЕТЫ / ИСТОЧНИК
        # =================================================

        ScrollView:

            id:
                question_scroll

            do_scroll_x:
                False

            do_scroll_y:
                True


            BoxLayout:

                orientation:
                    'vertical'

                size_hint_y:
                    None

                height:
                    self.minimum_height

                spacing:
                    dp(12)

                padding:
                    dp(4), dp(6), dp(4), dp(12)


                # =================================================
                # ВОПРОС
                # =================================================

                Label:

                    text:
                        root.question

                    color:
                        .08, .07, .06, 1

                    text_size:
                        self.width - dp(12), None

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(24)

                    font_size:
                        '19sp'

                    halign:
                        'left'

                    valign:
                        'middle'


                # =================================================
                # ОТВЕТЫ
                # =================================================

                BoxLayout:

                    id:
                        answers

                    orientation:
                        'vertical'

                    size_hint_y:
                        None

                    height:
                        self.minimum_height

                    spacing:
                        dp(10)


                # =================================================
                # СООБЩЕНИЕ / ПРАВИЛЬНЫЙ ОТВЕТ
                # =================================================

                Label:

                    text:
                        root.message

                    color:
                        .65, .15, .10, 1

                    font_size:
                        '15sp'

                    text_size:
                        self.width - dp(8), None

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(14) if root.message else 0

                    halign:
                        'left'

                    valign:
                        'middle'


                # =================================================
                # ИСТОЧНИК
                # =================================================

                BoxLayout:

                    orientation:
                        'vertical'

                    size_hint_y:
                        None

                    height:
                        self.minimum_height if root.source else 0

                    opacity:
                        1 if root.source else 0

                    padding:
                        dp(16), dp(14)

                    spacing:
                        dp(8)


                    canvas.before:

                        Color:

                            rgba:
                                (.94, .91, .86, 1) if root.source else (0, 0, 0, 0)

                        RoundedRectangle:

                            pos:
                                self.pos

                            size:
                                self.size

                            radius:
                                [dp(12)]


                    Label:

                        text:
                            'Источник' if root.source else ''

                        color:
                            .08, .07, .06, 1

                        font_size:
                            '18sp'

                        bold:
                            True

                        size_hint_y:
                            None

                        height:
                            self.texture_size[1] + dp(4) if root.source else 0

                        text_size:
                            self.width, None

                        halign:
                            'left'

                        valign:
                            'middle'


                    Label:

                        text:
                            root.source

                        color:
                            .08, .07, .06, 1

                        font_size:
                            '15sp'

                        bold:
                            False

                        size_hint_y:
                            None

                        height:
                            self.texture_size[1] + dp(6) if root.source else 0

                        text_size:
                            self.width, None

                        halign:
                            'left'

                        valign:
                            'top'


        # =================================================
        # ЗАВЕРШИТЬ
        # =================================================

        Button:

            text:
                'Завершить тестирование'

            color:
                .08, .07, .06, 1

            font_size:
                '16sp'

            background_normal:
                ''

            background_down:
                ''

            background_color:
                .86, .72, .59, 1

            size_hint_y:
                None

            height:
                dp(52)

            on_release:
                root.finish()


        # =================================================
        # НАВИГАЦИЯ
        # =================================================

        BoxLayout:

            size_hint_y:
                None

            height:
                dp(58)

            spacing:
                dp(10)


            Button:

                text:
                    'Предыдущий'

                color:
                    .08, .07, .06, 1

                font_size:
                    '15sp'

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    .80, .80, .80, 1

                disabled:
                    root.idx <= 0

                on_release:
                    root.prev()


            Button:

                text:
                    'Ответ'

                color:
                    .08, .07, .06, 1

                font_size:
                    '15sp'

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    .82, .76, .66, 1

                opacity:
                    1 if app.mode == 'обучение' else 0

                disabled:
                    app.mode != 'обучение'

                size_hint_x:
                    1 if app.mode == 'обучение' else 0

                width:
                    dp(90) if app.mode == 'обучение' else 0

                on_release:
                    root.show_correct()


            Button:

                text:
                    'Следующий'

                color:
                    .08, .07, .06, 1

                font_size:
                    '15sp'

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    .80, .80, .80, 1

                on_release:
                    root.next()


        Widget:

            size_hint_y:
                None

            height:
                dp(12)


# =========================================================
# РЕЗУЛЬТАТ
# =========================================================

<Result>:

    name:
        'result'

    canvas.before:

        Color:
            rgba: .96, .92, .85, 1

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:

        orientation:
            'vertical'

        padding:
            dp(28), dp(34), dp(28), dp(34)

        spacing:
            dp(18)


        Widget:


        Label:

            text:
                root.text

            color:
                .08, .07, .06, 1

            font_size:
                '22sp'

            halign:
                'center'

            valign:
                'middle'

            text_size:
                self.width, None


        Button:

            text:
                'На главный экран'

            color:
                .08, .07, .06, 1

            font_size:
                '16sp'

            background_normal:
                ''

            background_down:
                ''

            background_color:
                .83, .73, .61, 1

            size_hint_y:
                None

            height:
                dp(58)

            on_release:
                app.root.current = 'login'


        Widget:


# =========================================================
# НАСТРОЙКИ
# =========================================================

<AdminSettings>:

    name:
        'settings'

    canvas.before:

        Color:
            rgba: .96, .92, .85, 1

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:

        orientation:
            'vertical'

        padding:
            dp(18), dp(24), dp(18), dp(20)

        spacing:
            dp(10)


        # =================================================
        # HEADER
        # =================================================

        BoxLayout:

            size_hint_y:
                None

            height:
                dp(52)


            Button:

                text:
                    '‹'

                font_size:
                    '30sp'

                color:
                    .08, .07, .06, 1

                background_normal:
                    ''

                background_down:
                    ''

                background_color:
                    0, 0, 0, 0

                size_hint_x:
                    None

                width:
                    dp(48)

                on_release:
                    root.go_back()


            Label:

                text:
                    'Настройки'

                color:
                    .08, .07, .06, 1

                font_size:
                    '25sp'

                bold:
                    True

                halign:
                    'center'

                valign:
                    'middle'

                text_size:
                    self.size


            Widget:

                size_hint_x:
                    None

                width:
                    dp(48)


        # =================================================
        # ОСНОВНАЯ ПРОКРУТКА
        # =================================================

        ScrollView:

            do_scroll_x:
                False

            do_scroll_y:
                True


            BoxLayout:

                orientation:
                    'vertical'

                size_hint_y:
                    None

                height:
                    self.minimum_height

                spacing:
                    dp(12)

                padding:
                    dp(2), dp(6), dp(2), dp(20)


                # =================================================
                # ИСТОЧНИКИ
                # =================================================

                Label:

                    text:
                        'Источники вопросов'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '19sp'

                    bold:
                        True

                    size_hint_y:
                        None

                    height:
                        dp(36)

                    text_size:
                        self.width, None

                    halign:
                        'left'

                    valign:
                        'middle'


                Label:

                    text:
                        'Выберите нормативные документы, из которых будут формироваться вопросы.'

                    color:
                        .35, .32, .28, 1

                    font_size:
                        '13sp'

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(8)

                    text_size:
                        self.width, None

                    halign:
                        'left'

                    valign:
                        'top'


                # =================================================
                # ВЫБРАТЬ ВСЕ
                # =================================================

                BoxLayout:

                    orientation:
                        'horizontal'

                    size_hint_y:
                        None

                    height:
                        dp(52)

                    spacing:
                        dp(8)

                    padding:
                        dp(8), 0


                    canvas.before:

                        Color:
                            rgba: .91, .86, .78, 1

                        RoundedRectangle:

                            pos:
                                self.pos

                            size:
                                self.size

                            radius:
                                [dp(8)]


                    CheckBox:

                        id:
                            all_sources

                        size_hint_x:
                            None

                        width:
                            dp(44)

                        active:
                            root.all_sources_selected()

                        color:
                            .20, .16, .12, 1

                        on_active:

                            if self.active: root.select_all_sources()


                    Label:

                        text:
                            'Выбрать все'

                        color:
                            .08, .07, .06, 1

                        font_size:
                            '16sp'

                        bold:
                            True

                        halign:
                            'left'

                        valign:
                            'middle'

                        text_size:
                            self.size


                # =================================================
                # ДИНАМИЧЕСКИЙ СПИСОК .DAT
                # =================================================

                RecycleView:

                    id:
                        source_list

                    size_hint_y:
                        None

                    height:
                        min(dp(430), max(dp(80), source_layout.minimum_height))

                    viewclass:
                        'SourceRow'

                    data:
                        [{'source_id': item['id'], 'source_name': item['name'], 'selected': item['selected']} for item in root.get_sources()]

                    bar_width:
                        dp(6)

                    scroll_type:
                        ['bars', 'content']


                    RecycleBoxLayout:

                        id:
                            source_layout

                        default_size:
                            None, dp(78)

                        default_size_hint:
                            1, None

                        size_hint_y:
                            None

                        height:
                            self.minimum_height

                        orientation:
                            'vertical'

                        spacing:
                            dp(7)


                # =================================================
                # РАЗДЕЛИТЕЛЬ
                # =================================================

                Widget:

                    size_hint_y:
                        None

                    height:
                        dp(8)


                # =================================================
                # КОЛИЧЕСТВО ВОПРОСОВ
                # =================================================

                Label:

                    text:
                        'Количество вопросов'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '17sp'

                    bold:
                        True

                    size_hint_y:
                        None

                    height:
                        dp(32)

                    text_size:
                        self.width, None

                    halign:
                        'left'

                    valign:
                        'middle'


                TextInput:

                    id:
                        question_count

                    text:
                        str(int(app.question_count))

                    font_name:
                        'AppArial'

                    font_size:
                        '18sp'

                    multiline:
                        False

                    input_filter:
                        'int'

                    input_type:
                        'number'

                    size_hint_y:
                        None

                    height:
                        dp(54)

                    foreground_color:
                        .08, .07, .06, 1

                    background_normal:
                        ''

                    background_active:
                        ''

                    background_color:
                        1, 1, 1, 1

                    padding:
                        dp(14), dp(14)


                Label:

                    text:
                        'Количество вопросов в контрольном тестировании.'

                    color:
                        .35, .32, .28, 1

                    font_size:
                        '13sp'

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(6)

                    text_size:
                        self.width, None

                    halign:
                        'left'


                # =================================================
                # ВРЕМЯ
                # =================================================

                Label:

                    text:
                        'Время тестирования, минут'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '17sp'

                    bold:
                        True

                    size_hint_y:
                        None

                    height:
                        dp(32)

                    text_size:
                        self.width, None

                    halign:
                        'left'

                    valign:
                        'middle'


                TextInput:

                    id:
                        test_minutes

                    text:
                        str(int(app.test_minutes))

                    font_name:
                        'AppArial'

                    font_size:
                        '18sp'

                    multiline:
                        False

                    input_filter:
                        'int'

                    input_type:
                        'number'

                    size_hint_y:
                        None

                    height:
                        dp(54)

                    foreground_color:
                        .08, .07, .06, 1

                    background_normal:
                        ''

                    background_active:
                        ''

                    background_color:
                        1, 1, 1, 1

                    padding:
                        dp(14), dp(14)


                Label:

                    text:
                        'Таймер применяется только в режиме контрольного тестирования.'

                    color:
                        .35, .32, .28, 1

                    font_size:
                        '13sp'

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(6)

                    text_size:
                        self.width, None

                    halign:
                        'left'


                # =================================================
                # ПРОХОДНОЙ БАЛЛ
                # =================================================

                Label:

                    text:
                        'Условие успешного прохождения, %'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '17sp'

                    bold:
                        True

                    size_hint_y:
                        None

                    height:
                        dp(32)

                    text_size:
                        self.width, None

                    halign:
                        'left'

                    valign:
                        'middle'


                TextInput:

                    id:
                        pass_percent

                    text:
                        str(int(app.pass_percent))

                    font_name:
                        'AppArial'

                    font_size:
                        '18sp'

                    multiline:
                        False

                    input_filter:
                        'int'

                    input_type:
                        'number'

                    size_hint_y:
                        None

                    height:
                        dp(54)

                    foreground_color:
                        .08, .07, .06, 1

                    background_normal:
                        ''

                    background_active:
                        ''

                    background_color:
                        1, 1, 1, 1

                    padding:
                        dp(14), dp(14)


                Label:

                    text:
                        'Например: 80 означает, что необходимо правильно ответить минимум на 80% вопросов.'

                    color:
                        .35, .32, .28, 1

                    font_size:
                        '13sp'

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(6)

                    text_size:
                        self.width, None

                    halign:
                        'left'


                # =================================================
                # СООБЩЕНИЕ
                # =================================================

                Label:

                    text:
                        root.message

                    color:
                        (.12, .48, .18, 1) if root.message == 'Настройки сохранены' else (.70, .12, .10, 1)

                    font_size:
                        '14sp'

                    size_hint_y:
                        None

                    height:
                        self.texture_size[1] + dp(10) if root.message else 0

                    text_size:
                        self.width, None

                    halign:
                        'center'

                    valign:
                        'middle'


                # =================================================
                # СОХРАНИТЬ
                # =================================================

                Button:

                    text:
                        'Сохранить настройки'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '17sp'

                    bold:
                        True

                    background_normal:
                        ''

                    background_down:
                        ''

                    background_color:
                        .83, .73, .61, 1

                    size_hint_y:
                        None

                    height:
                        dp(60)

                    on_release:

                        root.save_settings(
                        question_count.text,
                        test_minutes.text,
                        pass_percent.text
                        )


                Button:

                    text:
                        'Назад'

                    color:
                        .08, .07, .06, 1

                    font_size:
                        '16sp'

                    background_normal:
                        ''

                    background_down:
                        ''

                    background_color:
                        .82, .82, .80, 1

                    size_hint_y:
                        None

                    height:
                        dp(54)

                    on_release:
                        root.go_back()


                Widget:

                    size_hint_y:
                        None

                    height:
                        dp(18)
