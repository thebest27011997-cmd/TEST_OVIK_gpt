#:import dp kivy.metrics.dp


<Label>:
    font_name: 'AppArial'


<Button>:
    font_name: 'AppArial'


<ToggleButton>:
    font_name: 'AppArial'


ScreenManager:
    Login:
    Test:
    Result:
    AdminSettings:


<Login>:
    name: 'login'

    canvas.before:
        Color:
            rgba: 0.96, 0.92, 0.85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        id: login_scroll
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: max(self.minimum_height, root.height)
            padding: dp(28), dp(18), dp(28), dp(28)
            spacing: dp(12)

            Widget:
                size_hint_y: None
                height: dp(12)

            # ЭМБЛЕМА
            Image:
                source: 'assets/logo.png'
                size_hint_y: None
                height: dp(125)
                fit_mode: 'contain'

            # НАЗВАНИЕ
            Label:
                text: 'ТехПрофи'
                color: 0.08, 0.07, 0.06, 1
                font_size: '32sp'
                bold: True
                size_hint_y: None
                height: dp(48)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # ДЕВИЗ
            Label:
                text: 'Знания. Безопасность. Профессионализм.'
                color: .22, .19, .16, 1
                font_size: '14sp'
                size_hint_y: None
                height: dp(34)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(8)

            # ФИО
            TextInput:
                id: name
                hint_text: 'Фамилия и инициалы'
                font_name: 'AppArial'
                font_size: '18sp'
                multiline: False
                size_hint_y: None
                height: dp(58)

                foreground_color: 0, 0, 0, 1
                hint_text_color: .45, .45, .45, 1

                background_normal: ''
                background_active: ''
                background_color: 1, 1, 1, 1

                padding:
                    [dp(14), (self.height - self.line_height) / 2 - dp(2)]

                on_text: root.update_admin_state()

            Label:
                id: msg
                text: ''
                color: .75, .1, .1, 1
                font_size: '14sp'
                size_hint_y: None
                height: dp(30) if self.text else 0
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'

            Button:
                text: 'Контрольное тестирование'
                color: 0.08, 0.07, 0.06, 1
                font_size: '17sp'

                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1

                size_hint_y: None
                height: dp(60)

                on_release: root.start('контроль')

            Button:
                text: 'Обучение'
                color: 0.08, 0.07, 0.06, 1
                font_size: '17sp'

                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1

                size_hint_y: None
                height: dp(60)

                on_release: root.start('обучение')

            Button:
                text: 'Настройки'

                color:
                    (0.08, 0.07, 0.06, 1) if root.admin_enabled else (.42, .42, .42, 1)

                background_normal: ''
                background_down: ''

                background_color:
                    (.83, .73, .61, 1) if root.admin_enabled else (.78, .78, .78, 1)

                disabled: not root.admin_enabled

                size_hint_y: None
                height: dp(56)

                on_release: root.open_settings()

            Widget:
                size_hint_y: None
                height: dp(20)


<Test>:
    name: 'test'

    canvas.before:
        Color:
            rgba: .97, .96, .94, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(14), dp(10), dp(14), dp(10)
        spacing: dp(8)

        # =================================================
        # ВЕРХНЯЯ СТРОКА
        # =================================================

        BoxLayout:
            size_hint_y: None
            height: dp(58)
            spacing: dp(10)

            Label:
                text: root.progress
                color: 0.08, 0.07, 0.06, 1
                font_size: '18sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            # ЦИФРОВЫЕ ЧАСЫ
            BoxLayout:
                size_hint_x: None
                width: dp(108)
                padding: dp(4)

                canvas.before:
                    Color:
                        rgba: .12, .105, .09, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

                canvas.after:
                    Color:
                        rgba: .68, .55, .40, 1
                    Line:
                        rounded_rectangle:
                            (self.x, self.y, self.width, self.height, dp(8))
                        width: 1.2

                Label:
                    text: root.timer
                    color: .98, .86, .62, 1
                    font_size: '22sp'
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

        # =================================================
        # ВОПРОСЫ
        # =================================================

        ScrollView:
            id: question_scroll
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(4), dp(6), dp(4), dp(10)

                Label:
                    text: root.question
                    color: .08, .07, .06, 1
                    text_size: self.width - dp(12), None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(30)
                    font_size: '19sp'
                    halign: 'left'
                    valign: 'middle'

                BoxLayout:
                    id: answers
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                Label:
                    text: root.message
                    color: .78, .08, .08, 1
                    font_size: '15sp'
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(40) if root.message else 0
                    halign: 'center'
                    valign: 'middle'

                Label:
                    text: root.source
                    color: .08, .07, .06, 1
                    text_size: self.width, None
                    size_hint_y: None
                    height:
                        self.texture_size[1] + dp(20) if root.source else 0
                    font_size: '15sp'
                    halign: 'left'
                    valign: 'middle'

        # =================================================
        # ЗАВЕРШЕНИЕ
        # =================================================

        Button:
            text: 'Завершить тестирование'
            color: .08, .07, .06, 1
            font_size: '16sp'

            background_normal: ''
            background_down: ''
            background_color: .86, .72, .59, 1

            size_hint_y: None
            height: dp(52)

            on_release: root.finish()

        # =================================================
        # НАВИГАЦИЯ
        # =================================================

        BoxLayout:
            size_hint_y: None
            height: dp(64)
            spacing: dp(10)

            Button:
                text: 'Предыдущий\nвопрос'
                color: .08, .07, .06, 1
                font_size: '15sp'
                halign: 'center'
                valign: 'middle'
                text_size: self.size

                background_normal: ''
                background_down: ''
                background_color: .80, .80, .80, 1

                disabled: root.idx <= 0

                on_release: root.prev()

            Button:
                text: 'Ответ'
                color: .08, .07, .06, 1
                font_size: '15sp'
                halign: 'center'
                valign: 'middle'
                text_size: self.size

                background_normal: ''
                background_down: ''
                background_color: .82, .76, .66, 1

                opacity:
                    1 if app.mode == 'обучение' else 0

                disabled:
                    app.mode != 'обучение'

                size_hint_x:
                    1 if app.mode == 'обучение' else 0

                width:
                    dp(100) if app.mode == 'обучение' else 0

                on_release: root.show_correct()

            Button:
                text: 'Следующий\nвопрос'
                color: .08, .07, .06, 1
                font_size: '15sp'
                halign: 'center'
                valign: 'middle'
                text_size: self.size

                background_normal: ''
                background_down: ''
                background_color: .80, .80, .80, 1

                on_release: root.next()


<Result>:
    name: 'result'

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(28)
        spacing: dp(18)

        Widget:

        Label:
            text: root.text
            color: .08, .07, .06, 1
            font_size: '24sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        Button:
            text: 'На главный экран'
            color: .08, .07, .06, 1
            font_size: '16sp'

            background_normal: ''
            background_down: ''
            background_color: .83, .73, .61, 1

            size_hint_y: None
            height: dp(58)

            on_release:
                app.root.current = 'login'

        Widget:


<AdminSettings>:
    name: 'settings'

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(28)
        spacing: dp(18)

        Label:
            text: 'Настройки'
            color: .08, .07, .06, 1
            font_size: '28sp'
            bold: True
            size_hint_y: None
            height: dp(60)

        Label:
            text: 'Административный режим'
            color: .08, .07, .06, 1
            font_size: '18sp'
            size_hint_y: None
            height: dp(48)

        Label:
            text: 'Параметры администратора добавим на следующем этапе.'
            color: .2, .2, .2, 1
            font_size: '16sp'
            text_size: self.width, None
            halign: 'center'
            valign: 'middle'

        Button:
            text: 'Назад'
            color: .08, .07, .06, 1
            font_size: '16sp'

            background_normal: ''
            background_down: ''
            background_color: .83, .73, .61, 1

            size_hint_y: None
            height: dp(58)

            on_release: root.go_back()
