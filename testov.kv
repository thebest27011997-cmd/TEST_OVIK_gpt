#:import dp kivy.metrics.dp


# =========================================================
# ОБЩИЕ НАСТРОЙКИ
# =========================================================

<Label>:
    font_name: 'AppArial'
    italic: False


<Button>:
    font_name: 'AppArial'
    italic: False


<ToggleButton>:
    font_name: 'AppArial'
    italic: False


# =========================================================
# ГЛАВНЫЙ ЭКРАН
# =========================================================

<Login>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: max(self.minimum_height, root.height)
            padding: dp(28), dp(18), dp(28), dp(28)
            spacing: dp(12)

            Widget:
                size_hint_y: None
                height: dp(12)

            # -------------------------------------------------
            # ЛОГОТИП
            # -------------------------------------------------

            Image:
                source: 'assets/logo.png'
                size_hint_y: None
                height: dp(125)
                fit_mode: 'contain'

            # -------------------------------------------------
            # НАЗВАНИЕ
            # -------------------------------------------------

            Label:
                text: 'ТехПрофи'
                color: .08, .07, .06, 1
                font_size: '32sp'
                bold: True
                size_hint_y: None
                height: dp(48)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Label:
                text: 'Знания. Безопасность. Профессионализм.'
                color: .22, .19, .16, 1
                font_size: '14sp'
                size_hint_y: None
                height: dp(34)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(8)

            # -------------------------------------------------
            # ФИО
            # -------------------------------------------------

            TextInput:
                id: name
                hint_text: 'Фамилия и инициалы'
                font_name: 'AppArial'
                font_size: '18sp'
                multiline: False
                size_hint_y: None
                height: dp(58)
                foreground_color: 0, 0, 0, 1
                hint_text_color: .45, .45, .45, 1
                background_normal: ''
                background_active: ''
                background_color: 1, 1, 1, 1
                padding: [dp(14), (self.height - self.line_height) / 2 - dp(2)]
                on_text: root.update_admin_state()

            Label:
                id: msg
                text: ''
                color: .75, .10, .10, 1
                font_size: '14sp'
                size_hint_y: None
                height: dp(30) if self.text else 0
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'

            # -------------------------------------------------
            # РЕЖИМЫ
            # -------------------------------------------------

            Button:
                text: 'Контрольное тестирование'
                color: .08, .07, .06, 1
                font_size: '17sp'
                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1
                size_hint_y: None
                height: dp(60)
                on_release: root.start('контроль')

            Button:
                text: 'Обучение'
                color: .08, .07, .06, 1
                font_size: '17sp'
                background_normal: ''
                background_down: ''
                background_color: .83, .73, .61, 1
                size_hint_y: None
                height: dp(60)
                on_release: root.start('обучение')

            Button:
                text: 'Настройки'
                color: (.08, .07, .06, 1) if root.admin_enabled else (.42, .42, .42, 1)
                background_normal: ''
                background_down: ''
                background_color: (.83, .73, .61, 1) if root.admin_enabled else (.70, .68, .64, 1)
                disabled: not root.admin_enabled
                size_hint_y: None
                height: dp(56)
                on_release: root.open_settings()

            Widget:
                size_hint_y: None
                height: dp(18)


# =========================================================
# ЭКРАН ТЕСТИРОВАНИЯ
# =========================================================

<Test>:

    canvas.before:
        Color:
            rgba: .97, .96, .94, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Нижний отступ увеличен.
        # Кнопки будут выше системной панели Android.
        padding: dp(14), dp(20), dp(14), dp(34)

        spacing: dp(8)


        # =====================================================
        # ВЕРХНЯЯ СТРОКА
        # НОМЕР ВОПРОСА + ЭЛЕКТРОННЫЙ ТАЙМЕР
        # =====================================================

        BoxLayout:
            size_hint_y: None
            height: dp(62)
            spacing: dp(10)

            # -------------------------------------------------
            # НОМЕР ВОПРОСА
            # -------------------------------------------------

            Label:
                text: root.progress
                color: .08, .07, .06, 1

                # Увеличено на 2 единицы
                font_size: '20sp'

                halign: 'left'
                valign: 'middle'
                text_size: self.size


            # -------------------------------------------------
            # ЭЛЕКТРОННЫЙ ТАЙМЕР
            #
            # Контроль:
            # ┌──────────┐
            # │  14:27   │
            # └──────────┘
            #
            # Обучение: полностью скрыт
            # -------------------------------------------------

            BoxLayout:
                size_hint_x: None
                width: dp(112) if app.mode == 'контроль' else 0
                opacity: 1 if app.mode == 'контроль' else 0
                disabled: app.mode != 'контроль'
                padding: dp(4) if app.mode == 'контроль' else 0

                # Внешняя золотисто-бежевая рамка
                canvas.before:
                    Color:
                        rgba: (.68, .56, .41, 1) if app.mode == 'контроль' else (0, 0, 0, 0)

                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(7)]

                # Чёрный дисплей
                BoxLayout:
                    padding: dp(2)

                    canvas.before:
                        Color:
                            rgba: (.045, .04, .035, 1) if app.mode == 'контроль' else (0, 0, 0, 0)

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(5)]

                    Label:
                        text: root.timer if app.mode == 'контроль' else ''
                        font_name: 'AppArial'
                        font_size: '24sp'
                        bold: True
                        color: .98, .88, .69, 1
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size


        # =====================================================
        # ВОПРОС + ОТВЕТЫ + ИСТОЧНИК
        # =====================================================

        ScrollView:
            id: question_scroll
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(4), dp(4), dp(4), dp(12)

                # -------------------------------------------------
                # ВОПРОС
                # -------------------------------------------------

                Label:
                    text: root.question
                    color: .08, .07, .06, 1
                    text_size: self.width - dp(12), None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(24)
                    font_size: '19sp'
                    halign: 'left'
                    valign: 'middle'

                # -------------------------------------------------
                # ВАРИАНТЫ ОТВЕТОВ
                # -------------------------------------------------

                BoxLayout:
                    id: answers
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                # -------------------------------------------------
                # СООБЩЕНИЕ / ПРАВИЛЬНЫЙ ОТВЕТ
                # -------------------------------------------------

                Label:
                    text: root.message
                    color: .65, .15, .10, 1
                    font_size: '15sp'
                    text_size: self.width - dp(8), None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(14) if root.message else 0
                    halign: 'left'
                    valign: 'middle'

                # -------------------------------------------------
                # ИСТОЧНИК
                # -------------------------------------------------

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if root.source else 0
                    opacity: 1 if root.source else 0
                    padding: dp(16), dp(14)
                    spacing: dp(8)

                    canvas.before:
                        Color:
                            rgba: (.94, .91, .86, 1) if root.source else (0, 0, 0, 0)

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: 'Источник' if root.source else ''
                        color: .08, .07, .06, 1
                        font_size: '18sp'
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1] + dp(4) if root.source else 0
                        text_size: self.width, None
                        halign: 'left'
                        valign: 'middle'

                    # Документ, раздел и текст пункта
                    # отображаются одинаковым шрифтом
                    Label:
                        text: root.source
                        color: .08, .07, .06, 1
                        font_size: '15sp'
                        bold: False
                        size_hint_y: None
                        height: self.texture_size[1] + dp(6) if root.source else 0
                        text_size: self.width, None
                        halign: 'left'
                        valign: 'top'


        # =====================================================
        # НИЖНИЕ КНОПКИ
        # =====================================================

        Button:
            text: 'Завершить тестирование'
            color: .08, .07, .06, 1
            font_size: '16sp'
            background_normal: ''
            background_down: ''
            background_color: .86, .72, .59, 1
            size_hint_y: None
            height: dp(52)
            on_release: root.finish()


        BoxLayout:
            size_hint_y: None
            height: dp(58)
            spacing: dp(10)

            Button:
                text: 'Предыдущий'
                color: .08, .07, .06, 1
                font_size: '15sp'
                background_normal: ''
                background_down: ''
                background_color: .80, .80, .80, 1
                disabled: root.idx <= 0
                on_release: root.prev()

            # Кнопка "Ответ" только для обучения
            Button:
                text: 'Ответ'
                color: .08, .07, .06, 1
                font_size: '15sp'
                background_normal: ''
                background_down: ''
                background_color: .82, .76, .66, 1
                opacity: 1 if app.mode == 'обучение' else 0
                disabled: app.mode != 'обучение'
                size_hint_x: 1 if app.mode == 'обучение' else 0
                width: dp(90) if app.mode == 'обучение' else 0
                on_release: root.show_correct()

            Button:
                text: 'Следующий'
                color: .08, .07, .06, 1
                font_size: '15sp'
                background_normal: ''
                background_down: ''
                background_color: .80, .80, .80, 1
                on_release: root.next()


        # Дополнительный отступ от Android navigation bar
        Widget:
            size_hint_y: None
            height: dp(14)


# =========================================================
# РЕЗУЛЬТАТ
# =========================================================

<Result>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(28), dp(34), dp(28), dp(34)
        spacing: dp(18)

        Widget:

        Label:
            text: root.text
            color: .08, .07, .06, 1
            font_size: '22sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        Button:
            text: 'На главный экран'
            color: .08, .07, .06, 1
            font_size: '16sp'
            background_normal: ''
            background_down: ''
            background_color: .83, .73, .61, 1
            size_hint_y: None
            height: dp(58)
            on_release: app.root.current = 'login'

        Widget:


# =========================================================
# НАСТРОЙКИ
# =========================================================

<AdminSettings>:

    canvas.before:
        Color:
            rgba: .96, .92, .85, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(18), dp(24), dp(18), dp(20)
        spacing: dp(10)

        # -------------------------------------------------
        # ЗАГОЛОВОК
        # -------------------------------------------------

        BoxLayout:
            size_hint_y: None
            height: dp(52)

            Button:
                text: '‹'
                font_size: '30sp'
                color: .08, .07, .06, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                size_hint_x: None
                width: dp(48)
                on_release: root.go_back()

            Label:
                text: 'Настройки'
                color: .08, .07, .06, 1
                font_size: '25sp'
                bold: True
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: None
                width: dp(48)


        # -------------------------------------------------
        # СОДЕРЖИМОЕ
        # -------------------------------------------------

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(2), dp(6), dp(2), dp(20)

                # ---------------------------------------------
                # ИСТОЧНИКИ
                # ---------------------------------------------

                Label:
                    text: 'Источники вопросов'
                    color: .08, .07, .06, 1
                    font_size: '19sp'
                    bold: True
                    size_hint_y: None
                    height: dp(36)
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'

                Label:
                    text: 'Выберите нормативные документы, из которых будут формироваться вопросы.'
                    color: .35, .32, .28, 1
                    font_size: '13sp'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'top'


                # ---------------------------------------------
                # ВЫБРАТЬ ВСЕ
                # ---------------------------------------------

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(52)
                    spacing: dp(8)
                    padding: dp(8), 0

                    canvas.before:
                        Color:
                            rgba: .91, .86, .78, 1

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]

                    CheckBox:
                        id: all_sources
                        size_hint_x: None
                        width: dp(44)
                        color: .20, .16, .12, 1
                        on_active: root.toggle_all_sources(self.active)

                    Label:
                        text: 'Выбрать все'
                        color: .08, .07, .06, 1
                        font_size: '16sp'
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size


                # ---------------------------------------------
                # СПИСОК .DAT
                # Создаётся динамически main.py
                # ---------------------------------------------

                BoxLayout:
                    id: sources_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(7)

                Widget:
                    size_hint_y: None
                    height: dp(8)


                # ---------------------------------------------
                # КОЛИЧЕСТВО ВОПРОСОВ
                # ---------------------------------------------

                Label:
                    text: 'Количество вопросов'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(32)
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'

                TextInput:
                    id: question_count
                    text: str(int(app.question_count))
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    foreground_color: .08, .07, .06, 1
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: 'Количество вопросов в контрольном тестировании.'
                    color: .35, .32, .28, 1
                    font_size: '13sp'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(6)
                    text_size: self.width, None
                    halign: 'left'


                # ---------------------------------------------
                # ВРЕМЯ
                # ---------------------------------------------

                Label:
                    text: 'Время тестирования, минут'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(32)
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'

                TextInput:
                    id: test_minutes
                    text: str(int(app.test_minutes))
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    foreground_color: .08, .07, .06, 1
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: 'Таймер применяется только в режиме контрольного тестирования.'
                    color: .35, .32, .28, 1
                    font_size: '13sp'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(6)
                    text_size: self.width, None
                    halign: 'left'


                # ---------------------------------------------
                # ПРОХОДНОЙ ПРОЦЕНТ
                # ---------------------------------------------

                Label:
                    text: 'Условие успешного прохождения, %'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    size_hint_y: None
                    height: dp(32)
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'

                TextInput:
                    id: pass_percent
                    text: str(int(app.pass_percent))
                    font_name: 'AppArial'
                    font_size: '18sp'
                    multiline: False
                    input_filter: 'int'
                    input_type: 'number'
                    size_hint_y: None
                    height: dp(54)
                    foreground_color: .08, .07, .06, 1
                    background_normal: ''
                    background_active: ''
                    background_color: 1, 1, 1, 1
                    padding: dp(14), dp(14)

                Label:
                    text: 'Например: 80 означает, что необходимо правильно ответить минимум на 80% вопросов.'
                    color: .35, .32, .28, 1
                    font_size: '13sp'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(6)
                    text_size: self.width, None
                    halign: 'left'


                # ---------------------------------------------
                # СООБЩЕНИЕ
                # ---------------------------------------------

                Label:
                    text: root.message
                    color: (.12, .48, .18, 1) if root.message == 'Настройки сохранены' else (.70, .12, .10, 1)
                    font_size: '14sp'
                    size_hint_y: None
                    height: self.texture_size[1] + dp(10) if root.message else 0
                    text_size: self.width, None
                    halign: 'center'
                    valign: 'middle'


                # ---------------------------------------------
                # СОХРАНИТЬ
                # ---------------------------------------------

                Button:
                    text: 'Сохранить настройки'
                    color: .08, .07, .06, 1
                    font_size: '17sp'
                    bold: True
                    background_normal: ''
                    background_down: ''
                    background_color: .83, .73, .61, 1
                    size_hint_y: None
                    height: dp(60)

                    on_release:
                        root.save_settings(question_count.text, test_minutes.text, pass_percent.text)


                Button:
                    text: 'Назад'
                    color: .08, .07, .06, 1
                    font_size: '16sp'
                    background_normal: ''
                    background_down: ''
                    background_color: .82, .82, .80, 1
                    size_hint_y: None
                    height: dp(54)
                    on_release: root.go_back()

                Widget:
                    size_hint_y: None
                    height: dp(18)
